{
  "name": "kumi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @kumi/desktop dev",
    "dist": "pnpm --filter @kumi/core build && pnpm --filter @kumi/desktop dist",
    "dist:win": "pnpm --filter @kumi/core build && pnpm --filter @kumi/desktop dist:win",
    "dev:web": "pnpm --filter @kumi/core build && pnpm --filter @kumi/desktop dev:web"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
